<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>motor-survey-ilaf</UserSecretsId>
  </PropertyGroup>
  <!-- Build with: dotnet build -p:UseOnnx=true  to include the ONNX AI engine -->
  <PropertyGroup Condition="'$(UseOnnx)'=='true'">
    <DefineConstants>$(DefineConstants);USE_ONNX</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MotorSurvey.Core\MotorSurvey.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseOnnx)'=='true'">
    <ProjectReference Include="..\MotorSurvey.Ai.Onnx\MotorSurvey.Ai.Onnx.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="data\**" CopyToPublishDirectory="PreserveNewest" />
    <None Update="data\**" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
